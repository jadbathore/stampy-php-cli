{
    "name": "stampy/php-cli",
    "description": "stampy/php-cli is a php extension that allows you to add cli components to a vanilla php application",
    "type": "composer-plugin",
    "version": "1.0.0",
    "autoload": {
        "psr-4": {
            "Stampy\\": "app/",
            "Test\\": "app/Controller/",
            "StampyConsole\\": "app/Controller/console/"
        }
    },
    "authors": [
        {
            "name": "jadbathore"
        }
    ],
    "require": {
        "php": ">=8.4",
        "composer-plugin-api": "*"
    },
    "require-dev": {
        "composer/composer": "^2.0"
    },
    "extra": {
        "class": "Stampy\\Extension\\Plugin"
    }
}