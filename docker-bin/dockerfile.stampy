

FROM --platform=$BUILDPLATFORM rust:latest 

RUN apt-get update && apt-get install -y \
    php \
    php-cli \
    php-dev \
    libclang-dev \
    tree;

COPY ./php-cli/init ./init
COPY ./php-cli/src ./rust/src
COPY ./php-cli/Cargo.toml ./rust
COPY ./php-cli/build.rs ./rust
COPY ./php-cli/composer.json ./composer.stampy.json
COPY ./composer.json ./

RUN mkdir app 
COPY ./php-cli/index ./
COPY ./php-cli/app/Model ./app/Model
COPY ./php-cli/app/config.php ./app

RUN cd rust && cargo build --release --features docker
RUN cp -r rust/target/release/libstampy_php_cli.so /usr/lib/php/20240924/stampy_php_cli.so 
RUN chmod 644 /usr/lib/php/20240924/stampy_php_cli.so;
RUN rm -rf rust