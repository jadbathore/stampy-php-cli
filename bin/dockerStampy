#!/bin/bash


NAME=$(pwd |cut -c2- | sed 's/\//-/g' | tr 'A-Z' 'a-z');
PROJECT_NAME=stampy-$NAME;
IMAGE="stampy";
max_length=128;
TAG=$(basename $PWD)-$$-$(date +%s);
TMP_CONTAINER="stampy_container"

if [ ${#TAG} -gt $max_length ]; then
  allowed_base_length=$((max_length - ${#IMAGE} - 1))
  TAG=$(echo "$TAG" | cut -c1-"$allowed_base_length")
fi

echo "\r"

FULL_IMAGE_NAME=$IMAGE:$TAG

if [ -L "./vendor/stampy/php-cli" ]; then
    tmp_doc=tmp-link-$$-$(date +%s)
    mkdir -p $tmp_doc

    unlink(){
        cp ./composer.json $tmp_doc/composer.json
        cp -R -L ./vendor/stampy/php-cli/ "$tmp_doc/php-cli/"
    }
    spinner="/|\\-";
    i=1;

    unlink & 
    pid=$!

    while kill -0 "$pid" 2>/dev/null; do
        i=$(((i + 1) % 4 ))
        printf "\r[%c] Copy of the symlinkfile..." "$(echo "$spinner"| cut -c $((i + 1)))"
        sleep 0.1
    done
    printf "\r\033[2K[✓] Done.\n"
    docker buildx build -f ./vendor/stampy/php-cli/docker-bin/dockerfile.stampy ./$tmp_doc -t $FULL_IMAGE_NAME --platform linux/arm64 --no-cache
    rm -rf $tmp_doc; 
else
    cp ./composer.json ./vendor/stampy/composer.json
    docker buildx build -f ./vendor/stampy/php-cli/docker-bin/dockerfile.stampy ./vendor/stampy -t $FULL_IMAGE_NAME --platform linux/arm64 --no-cache
    rm ./vendor/stampy/composer.json
fi
docker run -it --platform linux/arm64 --name $TMP_CONTAINER $FULL_IMAGE_NAME /bin/sh -c "
	COMPOSER=composer.json TRANSFERT=composer.stampy.json php -d extension=/usr/lib/php/20240924/stampy_php_cli.so init/docker-version/install.php > var.txt
";

docker cp $TMP_CONTAINER:/var.txt .env && \
docker cp $TMP_CONTAINER:/composer.stampy.json composer.stampy.json && \
docker cp $TMP_CONTAINER:/composer.json composer.json;
export $(grep -v '^#' .env); 
mkdir -p $ENTRY;
docker rm $TMP_CONTAINER;

docker run -it --platform linux/arm64 --name $TMP_CONTAINER $FULL_IMAGE_NAME /bin/sh -c \
"
    mkdir -p $ENTRY && \
    NO_COPY=true NAMESPACE=$NAMESPACE php -d extension=/usr/lib/php/20240924/stampy_php_cli.so init/create_controller.php $CONTROLLER > $ENTRY$CONTROLLER.php;
";

docker cp $TMP_CONTAINER:$ENTRY$CONTROLLER.php $ENTRY$CONTROLLER.php;
docker rm $TMP_CONTAINER;

export TAG=$TAG 
export CONTAINER_NAME=$PROJECT_NAME 
export PROJECT_ROOT=$(pwd) 

docker compose --project-name "$PROJECT_NAME" -f ./vendor/stampy/php-cli/docker-bin/docker-compose.yaml  build --no-cache --build-arg ENTRY=$ENTRY --build-arg CONTAINER_NAME=$PROJECT_NAME;
docker compose --project-name "$PROJECT_NAME" -f ./vendor/stampy/php-cli/docker-bin/docker-compose.yaml  up -d;